{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.buildBeforeRun": true,
  "cmake.useVsDeveloperEnvironment": "always",
  "terminal.integrated.profiles.windows": {
    "CUDA Developer PowerShell (x64)": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-Command",
        "Import-Module 'D:\\Software\\BuildTools\\Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll'; Enter-VsDevShell -VsInstallPath 'D:\\Software\\BuildTools' -SkipAutomaticLocation -Arch amd64 -HostArch amd64"
      ],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "CUDA Developer PowerShell (x64)",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "files.associations": {
    "*.cu": "cpp",
    "*.cuh": "cpp"
  },
  "files.exclude": {
    "**/build": false,
    "**/.vs": true
  },
  "search.exclude": {
    "**/build": true
  }
}
